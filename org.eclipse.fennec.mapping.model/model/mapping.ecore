<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="mapping" nsURI="https://eclipse.org/fennec/mapping/1.0.0" nsPrefix="mapping">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Generic EObject-to-EObject mapping of Eclipse Fennec: which value of which source object ends up in which slot of which target.&#xA;&#xA;One mapping has one target class and, per slot, one source. The way a value is obtained (ValueSource) is a ladder shared by every consumer: expression (OCL) &gt; functionId (with or without a feature path) &gt; feature path; the constant answers when the producer yields nothing; converterId post-processes a produced value. IdentityResolution says which target object a source object feeds, once per source class.&#xA;&#xA;Consumers (streaming, search, OGC features, the event atlas) extend Mapping and Slot with their own policies; trigger and direction (push or pull) are theirs, not the mapping&#x27;s. Mapping extends the engine-neutral DataTransformation of the shared atlas configuration model, so an atlas references a mapping like any other transformation."/>
    <details key="basePackage" value="org.eclipse.fennec.model"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0&#xA;&#xA;Contributors:&#xA;  Data In Motion Consulting - initial implementation"/>
    <details key="complianceLevel" value="21.0"/>
    <details key="oSGiCompatible" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Mapping" eSuperTypes="https://eclipse.org/fennec/atlas/configuration/1.0.0#//DataTransformation">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A mapping onto one target class. supportedEClasses (inherited) lists the source classes, resultEClasses the target; Mappings#normalize fills both from target, identities and slots, so atlas tooling can discover what a mapping reads and writes."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The target class. Unset for consumers whose target is no EClass (a search document): their slots are named."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="identities" upperBound="-1" eType="#//IdentityResolution" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How objects of each source class find their target object. At most one per (sourceClass, targetClass); shared by all slots reading that source class."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="slots" upperBound="-1" eType="#//Slot" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The slots of the target this mapping fills, each from exactly one source."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="includeUnmapped" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether features of the target that no slot names take part, as the consumer interprets it (search: indexed by convention; streaming: tracked as-is). Unset = the consumer&#x27;s default."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="IdentityResolution">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Which target object a source object feeds. Without a resolver the source object&#x27;s id IS the target id. A resolver is a ValueSource evaluated on the source object; it yields the target id, or a collection of ids to feed several targets (fan-out)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceClass" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The source class (and its subclasses)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetClass" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The target class; unset = the mapping&#x27;s target."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="resolver" eType="#//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Produces the target id(s) from the source object. Unset = same id."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cacheable" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the runtime may cache (sourceClass, sourceId) -&gt; target ids. False for resolvers whose answer changes without the source changing."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Slot">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One slot of the target, filled from one source. The value is produced on the source object by &#x27;value&#x27; and, when it is written into the target, converted by targetConverterId and coerced to the target feature&#x27;s type."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The slot&#x27;s name: required when there is no targetFeature (named slots), otherwise informational."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetFeature" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The feature of the target class this slot fills."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceClass" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The class the value is read from; unset = the target class itself (source = target)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="value" lowerBound="1" eType="#//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How the value is produced on the source object."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetConverterId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Converter applied when the value is written into the target, after the value was produced (and, for streaming, after it entered the stream). Unknown id = unconverted."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="unit" eType="#//UnitOfMeasurement" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The unit of the value written to targetFeature. Descriptive only: it does not convert the value; conversion stays with converterId, targetConverterId and expression. Unset = no unit declared by the mapping."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ValueSource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How one value is produced on a source object - the ladder shared by every consumer:&#xA;1. expression (OCL), evaluated with self = the source object; wins over everything else.&#xA;2. functionId: with a featurePath the function gets what the path found, without one the whole source object.&#xA;3. featurePath: navigated feature by feature; where it crosses a collection, collectionFilter, else collectionIndex picks the element.&#xA;The first declared producer answers - it is no fallback chain. When it yields nothing, the constant answers (parsed into the target type, not converted). converterId then post-processes a produced value."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="featurePath" upperBound="-1" unique="false" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The path from the source object to the value. Checked against the metamodel when the mapping is loaded."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="collectionIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" defaultValueLiteral="0">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The element to carry on from wherever the path crosses a collection, when no collectionFilter is set. Default 0."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="collectionFilter" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Selects the element of a crossed collection by value: &#x27;path.to.feature=value&#x27; (value optionally quoted), the first match wins; wins over collectionIndex."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expression" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="OCL expression with self = the source object. The first producer."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="functionId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Id of a registered function. An unknown id produces nothing."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="converterId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Id of a registered converter applied to the produced value. An unknown id leaves the value unconverted; a failing converter drops it."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="constant" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Literal that answers when the producer yields nothing or none is declared."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="UnitOfMeasurement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The unit of measurement of a value, e.g. for a SensorThings Datastream or an OGC features property. Descriptive only (hint-only): it never converts a value."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Human readable name of the unit, e.g. &#x27;degree Celsius&#x27;."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="symbol" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Symbol of the unit, e.g. &#x27;°C&#x27;."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="definition" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="URI defining the unit, e.g. a UCUM reference such as &#x27;http://unitsofmeasure.org/ucum.html#para-30&#x27;."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
