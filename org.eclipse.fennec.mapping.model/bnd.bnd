Bundle-Name: Eclipse Fennec Mapping Model
Bundle-Description: Generic EObject-to-EObject mapping metamodel: target class, slots, identity \
	resolution per source class and the shared value ladder (OCL expression, function, feature path, \
	constant, converter). Consumed by streaming, search, OGC features and the event atlas.

src=${^src},src-gen

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-library: enableEMF

# The code generation takes a bit of time and makes the build a bit slower.
# It might be a good idea to put comments around it, when you don't need it
-generate:\
	model/mapping.genmodel;\
		generate=fennecEMF;\
		lineEndings=lf;\
		genmodel=model/mapping.genmodel;\
		output=src-gen
# Add this attribute to find some logging information
#		logfile=test.log;\

# If this is not done with a instruction namespace, bnd would think you like
# to take full control over whats exported and imported and will ignore @Export
# Bundle Annotations
-includeresource.model: model=model

Bundle-Version: 0.1.1.SNAPSHOT

-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.atlas.configuration.model;version=project
