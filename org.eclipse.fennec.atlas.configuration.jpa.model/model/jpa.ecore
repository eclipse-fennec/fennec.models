<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="jpa" nsURI="https://eclipse.org/fennec/atlas/configuration/jpa/1.0.0"
    nsPrefix="atlasconfigjpa">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="JPA extension of the shared atlas configuration model: data inputs backed by a relational database through JPA (EclipseLink), with their entity mapping (Fennec eorm).&#xA;&#xA;Kept apart from the atlas configuration model, so that only atlases using JPA depend on the eorm model."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="JPADataInput" eSuperTypes="../../org.eclipse.fennec.atlas.configuration.model/model/configuration.ecore#//DataInput">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="DataInput backed by any relational data source supported by e.g. EclipseLink (JPA)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="persistenceConfig" eType="ecore:EClass https://eclipse.org/fennec/persistence/eorm/1.0.0#//EntityMappings"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JPA entity mapping (the EclipseLink orm.xml equivalent) describing how the model types map to the relational schema. Set it when the derived naming cannot address the schema - e.g. lower-case or schema-qualified tables, or a table without a primary key that needs a declared composite id.&#xA;Containment, deliberately: the mapping has to travel WITH the configuration. A non-containment href into a deployment-local file cannot be resolved by a Model Atlas that serves the configuration, which fails the upload with an unresolved EClass proxy. If a mapping ever needs to be shared between inputs, that belongs in a registry of the configuration root, like the other reusables."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dataSource" lowerBound="1"
        eType="ecore:EClass ../../org.eclipse.fennec.atlas.configuration.model/model/configuration.ecore#//JdbcDataSource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The JDBC data source definition providing the database connection for this input - bound by filter or materialized from its connection definition, the input does not care which."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
