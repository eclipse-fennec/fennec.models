Bundle-Name: Eclipse Fennec Units Model
Bundle-Description: Units of measurement as a shared model: Unit (identified by its UCUM code), \
	QuantityKind and Dimension, plus a catalog of common SI, environmental and DWD units at \
	https://eclipse.org/fennec/units. Holds no conversion data; conversion belongs to the consumer.

src=${^src},src-gen

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-library: enableEMF

# The code generation takes a bit of time and makes the build a bit slower.
# It might be a good idea to put comments around it, when you don't need it
-generate:\
	model/units.genmodel;\
		generate=fennecEMF;\
		lineEndings=lf;\
		genmodel=model/units.genmodel;\
		output=src-gen
# Add this attribute to find some logging information
#		logfile=test.log;\

# If this is not done with a instruction namespace, bnd would think you like
# to take full control over whats exported and imported and will ignore @Export
# Bundle Annotations
-includeresource.model: model=model

Bundle-Version: 0.1.0.SNAPSHOT

-buildpath: \
	org.osgi.service.condition;version=latest

-testpath: \
	junit-jupiter-api;version=latest
